# Server only. Never use VITE_ prefixes for credentials.
PORT=8787
# Replace both placeholders; model query is your existing realtime deployment name.
AZURE_REALTIME_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/openai/v1/realtime?model=YOUR-REALTIME-DEPLOYMENT
AZURE_OPENAI_API_KEY=
# REQUIRED: an existing Azure-supported transcription deployment on this resource.
# Example model family: gpt-4o-mini-transcribe. Enter YOUR deployment name, not a guessed one.
AZURE_TRANSCRIPTION_DEPLOYMENT=
AZURE_VOICE=marin

JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# Highest-choice probability must reach this threshold, otherwise uncertain.
# Provisional, NOT accuracy-calibrated. Tune on tuning split, then freeze.
JEV_MIN_PROBABILITY=0.8

# Separate structured-output LLM judge. No deployment is assumed.
# Standard OpenAI: https://api.openai.com/v1
# Azure v1: https://YOUR-RESOURCE.openai.azure.com/openai/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# bearer for OpenAI or Azure v1; api-key also supported for Azure.
LLM_AUTH=bearer
# Leave empty to OMIT. Set only an effort your chosen model supports.
LLM_REASONING_EFFORT=
LLM_MAX_COMPLETION_TOKENS=1024

JUDGE_TIMEOUT_MS=4000
JUDGE_MAX_REQUESTS_PER_MINUTE=240
# Live transcript logging is opt-in; eval logs always contain synthetic cases.
LOG_LIVE_TRANSCRIPTS=false
